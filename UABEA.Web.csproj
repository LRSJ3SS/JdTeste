<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- AOT desativado: PublishAot do projeto original não é compatível
         com o pipeline browser-wasm do Blazor. Deixe como interpretado
         (ou troque para RunAOTCompilation quando estiver estável). -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmEnableThreads>false</WasmEnableThreads>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.8" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.8" PrivateAssets="all" />

    <!-- Mesma lib que o UABEA original usa para parsear .assets/bundle.
         É C# puro (sem P/Invoke), então roda sob Mono-wasm sem alterações. -->
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />

    <!-- Usadas pela lógica original (Logic/, Utils/, Workspace/).
         Ambas são C#/IL puro e costumam funcionar sob WASM. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />

    <!--
      NÃO incluídos nesta primeira versão (ver README-PORT.md):
      - Samboy063.LibCpp2IL      -> só necessário para jogos IL2CPP; adicionar depois se precisar
      - SixLabors.ImageSharp     -> puro C#, dá pra adicionar quando o TexturePlugin for portado
      - TexToolWrap (ispc/crunch/PVRTexLib) -> bibliotecas NATIVAS (C/C++), não rodam em WASM
        sem recompilar para Emscripten. Decodificação de textura fica fora por enquanto.
    -->
  </ItemGroup>

</Project>
